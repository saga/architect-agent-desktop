{
  "name": "architect-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform desktop workspace with a built-in multi-tab web browser.",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node scripts/copy-rust-sandbox.mjs && concurrently -k -n VITE,TSC,ELECTRON \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p tsconfig.electron.json && node scripts/copy-rust-sandbox.mjs",
    "package:mac": "npm run typecheck && npm test && npm run build && npm run package:rust-sandbox && electron-builder --mac dmg zip --publish never",
    "package:win": "npm run typecheck && npm test && npm run build && npm run package:rust-sandbox && electron-builder --win nsis --publish never",
    "test:layout": "npm run build && node --test tests/layout-engine.test.mjs",
    "test": "node --check scripts/rust-toolchain-discovery.mjs && node --check scripts/package-rust-sandbox.mjs && node --check src/main/sandbox/mcp-server.mjs && node --check src/main/sandbox/rust-execution.mjs && node --check src/main/sandbox/rust-policy.mjs && vitest run",
    "package:rust-sandbox": "node scripts/package-rust-sandbox.mjs --require",
    "package": "npm run typecheck && npm test && npm run build && npm run package:rust-sandbox && electron-builder --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.10.0",
    "@ant-design/x-markdown": "^2.10.0",
    "@github/copilot-sdk": "^1.0.34",
    "@tencent-ai/agent-sdk": "^0.3.300",
    "antd": "^6.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "@microsoft/mxc-sdk": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.saga.architectagentdesktop",
    "productName": "Architect Agent Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "binaries": [
        "Contents/Resources/rust-sandbox/rust-toolchain/bin/rustc",
        "Contents/Resources/rust-sandbox/rust-toolchain/bin/cargo",
        "Contents/Resources/rust-sandbox/rust-toolchain/lib/**/*.dylib",
        "Contents/Resources/rust-sandbox/rust-toolchain/lib/rustlib/**/bin/rust-lld",
        "Contents/Resources/rust-sandbox/wasmer/wasmer"
      ]
    },
    "dmg": {
      "title": "Architect Agent Desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "dist/main/sandbox/**",
      "**/node_modules/@microsoft/mxc-sdk/**",
      "**/node_modules/koffi/**",
      "**/node_modules/node-pty/**",
      "**/node_modules/semver/**"
    ],
    "extraResources": [
      {
        "from": "resources/rust-sandbox",
        "to": "rust-sandbox",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "koffi": true,
    "node-pty": true,
    "semver": true,
    "electron-winstaller": true
  }
}
