# MCP OAuth is opt-in. Existing HTTP Headers / Bearer-token behaviour is unchanged when disabled.
MCP_OAUTH_ENABLED=false

# Microsoft Entra ID public-client app registration. Never put a client secret in a desktop app.
# Register the Mobile and desktop applications redirect URI: http://localhost
MCP_OAUTH_TENANT_ID=<your-tenant-id>
MCP_OAUTH_CLIENT_ID=<architect-agent-desktop-public-client-id>

# Fallback when the MCP server does not send a scope in its WWW-Authenticate challenge.
MCP_OAUTH_SCOPES=

# Optional per-server override (MCP Server ID uppercased; hyphens become underscores).
# MCP_OAUTH_SCOPES_GITHUB=api://<mcp-api-app-id>/access_as_user
