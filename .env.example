# Local-only experimental providers. Disabled by default.
# Set true on your development machine to expose the CodeBuddy SDK adapter.
ARCHITECT_AGENT_DEV_MODE=false

# Local OpenAI-compatible API (loopback only; defaults shown).
# ARCHITECT_LOCAL_SERVER_PORT=4317
# ARCHITECT_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ARCHITECT_LOCAL_LLM_API_KEY=
